# Copy to .env and adjust. All of these are optional — the defaults in
# src/marketing_pipeline/config.py apply when a variable is unset.
# Ollama server address (default http://localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434
# Model names (defaults: qwen3:14b planner/writer, qwen3:8b synthesis,
# bge-m3 embeddings).
# OLLAMA_PLANNER_MODEL=qwen3:14b
# OLLAMA_WRITER_MODEL=qwen3:14b
# OLLAMA_SYNTH_MODEL=qwen3:8b
# OLLAMA_EMBED_MODEL=bge-m3
# Context window for generation calls (default 2048).
# OLLAMA_NUM_CTX=2048
# Your brand name as it appears in drafts (default "Example Consulting").
# BRAND_NAME=Example Consulting
# Knowledge base folder (default ./knowledge_base).
# KNOWLEDGE_BASE_DIR=knowledge_base
# Checkpoint DB path (default ./step7.db).
# CHECKPOINT_DB=step7.db
